# Example environment variables for SocialMusic backend
# Copy this file to .env and fill in your API keys. Do NOT commit .env to your repository.

LASTFM_API_KEY=your_lastfm_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost/socialmusic_backend/api/spotify/spotify_callback_owner.php
SPOTIFY_USER_REDIRECT_URI=https://backend-socialmusic.onrender.com/api/spotify/spotify_user_callback.php

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_NAME=sistema_auth
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
