# Example environment variables for SocialMusic backend
# Copy this file to .env and fill in your API keys. Do NOT commit .env to your repository.

LASTFM_API_KEY=your_lastfm_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Database Configuration
DB_HOST=localhost
DB_NAME=sistema_auth
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
